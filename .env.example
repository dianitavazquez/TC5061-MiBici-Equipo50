# Copia este archivo como .env y personaliza los valores locales si es necesario.
# Nunca agregues el archivo .env ni credenciales reales al repositorio.
MLFLOW_TRACKING_URI=http://127.0.0.1:5050
MLFLOW_EXPERIMENT_NAME=mibici-equipo50

# Recuperación del modelo P2 para inferencia. El contenedor usa por defecto la
# copia descargada en models/serving/p2; cambia a "registry" para cargarla de MLflow.
MIBICI_MODEL_SOURCE=bundled
MIBICI_MODEL_PATH=models/serving/p2
MLFLOW_MODEL_NAME=mibici-equipo50-p2-riesgo
MLFLOW_MODEL_ALIAS=champion
# MLFLOW_MODEL_VERSION=2
